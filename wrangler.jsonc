{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocbot-personal",
  "main": "apps/control-worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace", "Sandbox"] }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./images/computer/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "ocbot-personal-artifacts" }],
  "vars": {
    "OPENCODE_VERSION": "2.0.11",
    "SANDBOX_PACKAGE_VERSION": "0.12.9"
  }
}
