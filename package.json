{
  "name": "opencode-bot",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:worker": "wrangler dev --port 8789",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test runner/test/*.test.mjs packages/runtime-opencode2/test/*.test.mjs scripts/*.test.mjs && bash boat/workspace-setup.test.sh",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --doctor",
    "deploy": "npm run build && wrangler deploy",
    "runner": "node runner/server.mjs",
    "preview:worker": "node scripts/preview-worker.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@opencode/client": "2.0.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-to": "^1.5.2",
    "lucide-react": "0.577.0",
    "mdast-util-from-markdown": "2.0.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "blake3-wasm": "2.1.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "license": "MIT"
}
