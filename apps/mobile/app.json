{
  "expo": {
    "name": "OpenCode Bot",
    "slug": "opencode-bot",
    "scheme": "opencode-bot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenCode Bot to attach photos to your bot conversations."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenCode Bot to take photos and scan device invitations."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opencode.bot.mobile"
    },
    "android": {
      "package": "com.opencode.bot.mobile"
    }
  }
}
